{
	"info": {
		"_postman_id": "formyfans-ai-credits-collection",
		"name": "FormyFans — AI & Credits (Auto-Auth)",
		"description": "Complete collection for the FormyFans AI content generation platform.\n\n## Auto-Auth Setup\nAfter calling **Login User** or **Login Creator**, the JWT token is automatically saved to the `{{auth_token}}` collection variable and used in all subsequent requests via `Bearer {{auth_token}}`.\n\n## Typical Flow\n1. **Login** → token auto-saved\n2. **Check Credit Balance** → see available credits\n3. **Purchase Credits** (if needed) → buy via Stripe\n4. **Refine Prompt** → send raw prompt, get AI-optimized prompt back\n5. **Generate Image / Video / Video Edit** → pass `promptId` from step 4\n6. **Poll Generation Status** → check progress until completed\n\n## Environment Variables\n| Variable | Default | Description |\n|---|---|---|\n| `base_url` | `http://localhost:5000/api` | API base URL |\n| `auth_token` | _(auto-set on login)_ | JWT Bearer token |",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000/api",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "prompt_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "generation_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "content_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "payment_intent_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "🔐 Auth",
			"description": "Authentication endpoints. Login auto-saves the JWT token to `{{auth_token}}`.",
			"item": [
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"",
									"if (res.token) {",
									"    pm.collectionVariables.set('auth_token', res.token);",
									"    console.log('✅ auth_token updated from login response');",
									"}",
									"",
									"pm.test('Login successful', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(res.token).to.be.a('string');",
									"});",
									"",
									"pm.test('Token saved to collection variable', function () {",
									"    pm.expect(pm.collectionVariables.get('auth_token')).to.not.be.empty;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"your_password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login-user",
							"host": ["{{base_url}}"],
							"path": ["auth", "login-user"]
						},
						"description": "Logs in a user and **auto-saves** the JWT token to `{{auth_token}}` collection variable.\n\nAll subsequent requests automatically use this token."
					},
					"response": []
				},
				{
					"name": "Login Creator",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"",
									"if (res.token) {",
									"    pm.collectionVariables.set('auth_token', res.token);",
									"    console.log('✅ auth_token updated from creator login');",
									"}",
									"",
									"pm.test('Creator login successful', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(res.token).to.be.a('string');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"creator@example.com\",\n  \"password\": \"your_password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login-creator",
							"host": ["{{base_url}}"],
							"path": ["auth", "login-creator"]
						},
						"description": "Logs in a content creator and **auto-saves** the JWT token."
					},
					"response": []
				}
			]
		},
		{
			"name": "🧠 AI — Prompt Refinement",
			"description": "Step 1 of the AI generation flow. Send a raw prompt and receive an AI-optimized production prompt.\n\n**Flow:** Raw Prompt → OpenAI GPT refines → Saved `promptId` → Use in generation endpoints.",
			"item": [
				{
					"name": "Refine Prompt — IMAGE",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"",
									"pm.test('Prompt refined successfully', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(res.status).to.eql('success');",
									"});",
									"",
									"if (res.data && res.data.promptId) {",
									"    pm.collectionVariables.set('prompt_id', res.data.promptId);",
									"    console.log('✅ prompt_id saved:', res.data.promptId);",
									"}",
									"",
									"pm.test('Refined prompt is returned', function () {",
									"    pm.expect(res.data.refinedPrompt).to.be.a('string');",
									"    pm.expect(res.data.refinedPrompt.length).to.be.greaterThan(10);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"IMAGE\",\n  \"prompt\": \"A breathtaking cinematic landscape showcasing the beauty of Bangladesh at golden hour, featuring the lush green countryside, winding rivers, traditional wooden boats, vibrant rural life, and distant greenery under a dramatic warm sunset sky. Capture the authentic natural beauty and cultural character of Bangladesh with photorealistic details, cinematic composition, atmospheric lighting, and rich depth.\",\n  \"style\": \"Cinematic, Photorealistic\",\n  \"settings\": {\n    \"resolution\": \"1080p\",\n    \"aspectRatio\": \"16:9\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/ai/prompts/refine",
							"host": ["{{base_url}}"],
							"path": ["ai", "prompts", "refine"]
						},
						"description": "Sends a raw IMAGE prompt to OpenAI GPT for refinement.\n\n**Response** includes:\n- `promptId` — use this in generation endpoints\n- `refinedPrompt` — the AI-optimized production prompt\n- `originalPrompt` — your original input\n\nThe `promptId` is auto-saved to `{{prompt_id}}` collection variable."
					},
					"response": []
				},
				{
					"name": "Refine Prompt — VIDEO",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"",
									"pm.test('Video prompt refined successfully', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(res.status).to.eql('success');",
									"});",
									"",
									"if (res.data && res.data.promptId) {",
									"    pm.collectionVariables.set('prompt_id', res.data.promptId);",
									"    console.log('✅ prompt_id saved:', res.data.promptId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"VIDEO\",\n  \"prompt\": \"A drone flyover of the Sundarbans mangrove forest in Bangladesh during sunrise, capturing misty waterways, wildlife, and the dense canopy from above with smooth cinematic camera movement.\",\n  \"style\": \"Cinematic, Drone Footage\",\n  \"settings\": {\n    \"resolution\": \"720p\",\n    \"aspectRatio\": \"16:9\",\n    \"duration\": 10\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/ai/prompts/refine",
							"host": ["{{base_url}}"],
							"path": ["ai", "prompts", "refine"]
						},
						"description": "Refines a VIDEO generation prompt via OpenAI GPT."
					},
					"response": []
				},
				{
					"name": "Refine Prompt — VIDEO_EDIT",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"",
									"pm.test('Video edit prompt refined', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(res.status).to.eql('success');",
									"});",
									"",
									"if (res.data && res.data.promptId) {",
									"    pm.collectionVariables.set('prompt_id', res.data.promptId);",
									"    console.log('✅ prompt_id saved:', res.data.promptId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"VIDEO_EDIT\",\n  \"prompt\": \"Apply a warm golden-hour color grading to the entire video. Enhance contrast, add subtle lens flare, and make the sky more dramatic while keeping the original motion intact.\",\n  \"style\": \"Cinematic Color Grade\",\n  \"settings\": {\n    \"resolution\": \"720p\",\n    \"aspectRatio\": \"16:9\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/ai/prompts/refine",
							"host": ["{{base_url}}"],
							"path": ["ai", "prompts", "refine"]
						},
						"description": "Refines a VIDEO_EDIT instruction prompt. The GPT is instructed to preserve the user's edit intent and not add unrelated changes."
					},
					"response": []
				},
				{
					"name": "Get Refined Prompt by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"",
									"pm.test('Prompt retrieved successfully', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(res.status).to.eql('success');",
									"});",
									"",
									"pm.test('Contains refined prompt data', function () {",
									"    pm.expect(res.data).to.have.property('originalPrompt');",
									"    pm.expect(res.data).to.have.property('refinedPrompt');",
									"    pm.expect(res.data).to.have.property('type');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/ai/prompts/{{prompt_id}}",
							"host": ["{{base_url}}"],
							"path": ["ai", "prompts", "{{prompt_id}}"]
						},
						"description": "Fetches a previously refined prompt by its ID.\n\nUses the auto-saved `{{prompt_id}}` from the refine step."
					},
					"response": []
				},
				{
					"name": "List All Refined Prompts",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"",
									"pm.test('Prompts list retrieved', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(res.data.data).to.be.an('array');",
									"});",
									"",
									"pm.test('Pagination included', function () {",
									"    pm.expect(res.data.pagination).to.have.property('totalCount');",
									"    pm.expect(res.data.pagination).to.have.property('totalPages');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/ai/prompts?page=1&limit=10",
							"host": ["{{base_url}}"],
							"path": ["ai", "prompts"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" },
								{ "key": "type", "value": "IMAGE", "disabled": true }
							]
						},
						"description": "Lists all refined prompts for the authenticated user with pagination.\n\nOptional query: `type=IMAGE|VIDEO|VIDEO_EDIT` to filter."
					},
					"response": []
				}
			]
		},
		{
			"name": "📤 AI — Media Uploads (S3)",
			"description": "Upload reference media (video/image) to S3 for use in VIDEO_EDIT or Image-to-Video generation.",
			"item": [
				{
					"name": "Get Presigned Upload URL",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"",
									"pm.test('Presigned URL generated', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(res.status).to.eql('success');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fileName\": \"my-reference-video.mp4\",\n  \"fileType\": \"video/mp4\",\n  \"fileCategory\": \"videoReference\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/ai/uploads/presign",
							"host": ["{{base_url}}"],
							"path": ["ai", "uploads", "presign"]
						},
						"description": "Generates a presigned S3 PUT URL. Use the returned URL to upload the file directly via PUT request with binary body.\n\n`fileCategory`: `videoReference` | `imageReference` | `aiInput`"
					},
					"response": []
				},
