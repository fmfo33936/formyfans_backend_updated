							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fileName\": \"reference-image.jpg\",\n  \"fileType\": \"image/jpeg\",\n  \"base64Data\": \"/9j/4AAQSkZJRgABAQ...YOUR_BASE64_HERE...\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/ai/uploads/direct",
							"host": ["{{base_url}}"],
							"path": ["ai", "uploads", "direct"]
						},
						"description": "Uploads a file directly as base64 encoded data. Returns the S3 key to use as `videoReference` or `imageReference` in generation requests."
					},
					"response": []
				}
			]
		},
		{
			"name": "🎨 AI — Generation (Dedicated Endpoints)",
			"description": "Step 2 of the AI flow. After refining a prompt, use these dedicated endpoints to generate content.\n\nPass the `promptId` from the refinement step, OR pass `refinedPrompt` directly.",
			"item": [
				{
					"name": "Generate Image",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"",
									"pm.test('Image generation started', function () {",
									"    pm.response.to.have.status(202);",
									"    pm.expect(res.status).to.eql('success');",
									"});",
									"",
									"if (res.data && res.data.generationId) {",
									"    pm.collectionVariables.set('generation_id', res.data.generationId);",
									"    console.log('✅ generation_id saved:', res.data.generationId);",
									"}",
									"if (res.data && res.data.contentId) {",
									"    pm.collectionVariables.set('content_id', res.data.contentId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"promptId\": \"{{prompt_id}}\",\n  \"resolution\": \"1080p\",\n  \"aspectRatio\": \"16:9\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/ai/generate/image",
							"host": ["{{base_url}}"],
							"path": ["ai", "generate", "image"]
						},
						"description": "Generates an AI image using a previously refined prompt.\n\n**Option A** — Use `promptId` from the refine step (recommended):\n```json\n{ \"promptId\": \"...\", \"resolution\": \"1080p\", \"aspectRatio\": \"16:9\" }\n```\n\n**Option B** — Pass prompt directly:\n```json\n{ \"prompt\": \"Your raw prompt\", \"resolution\": \"1080p\", \"aspectRatio\": \"16:9\" }\n```\n\n**Option C** — Pass already-refined prompt:\n```json\n{ \"refinedPrompt\": \"Your refined prompt\", \"resolution\": \"1080p\", \"aspectRatio\": \"16:9\" }\n```\n\nThe `type` is auto-set to `IMAGE` by this endpoint."
					},
					"response": []
				},
