<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="format-detection"
      content="telephone=no, date=no, address=no, email=no"
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>Your verification code</title>
    <!--[if mso]>
      <xml
        ><o:OfficeDocumentSettings
          ><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings
        ></xml
      >
    <![endif]-->
    <style type="text/css">
      body,
      table,
      td,
      a {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      table,
      td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        outline: none;
        text-decoration: none;
        display: block;
      }
      table {
        border-collapse: collapse !important;
      }
      body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        height: 100% !important;
      }
      a {
        color: #d81b60;
        text-decoration: none;
      }

      @media screen and (max-width: 600px) {
        .wrap {
          width: 100% !important;
        }
        .pad {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
        .code {
          font-size: 36px !important;
          letter-spacing: 8px !important;
        }
        .h1 {
          font-size: 22px !important;
        }
      }

      @media (prefers-color-scheme: dark) {
        .bg {
          background-color: #140b12 !important;
        }
        .foot {
          background-color: #140b12 !important;
        }
        .foot-text {
          color: #9c8291 !important;
        }
      }
      [data-ogsc] .bg {
        background-color: #140b12 !important;
      }
      [data-ogsc] .foot {
        background-color: #140b12 !important;
      }
      [data-ogsc] .foot-text {
        color: #9c8291 !important;
      }
    </style>
  </head>

  <body class="bg" style="margin: 0; padding: 0; background-color: #f7eff3">
    <!-- preheader -->
    <div
      style="
        display: none;
        font-size: 1px;
        color: #f7eff3;
        line-height: 1px;
        max-height: 0;
        max-width: 0;
        opacity: 0;
        overflow: hidden;
      "
    >
      Your For My Fans Only code is <%= otp %>. It expires in <%=
      expiresInMinutes %> minutes.
      &#8199;&#65279;&#8199;&#65279;&#8199;&#65279;&#8199;&#65279;&#8199;&#65279;&#8199;&#65279;&#8199;&#65279;&#8199;&#65279;&#8199;&#65279;&#8199;&#65279;&#8199;&#65279;&#8199;&#65279;
    </div>

    <table
      role="presentation"
      class="bg"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f7eff3"
    >
      <tr>
        <td align="center" style="padding: 32px 12px">
          <table
            role="presentation"
            class="wrap"
            width="560"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 560px; max-width: 560px"
          >
            <!-- ============ CARD ============ -->
            <tr>
              <td
                class="card"
                style="
                  background-color: #ffffff;
                  border: 1px solid #efdde6;
                  border-radius: 20px;
                  overflow: hidden;
                "
              >
                <!-- banner -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                >
                  <tr>
                    <td
                      align="center"
                      style="padding: 0; font-size: 0; line-height: 0"
                    >
                      <img
                        src="<%= logoUrl %>"
                        width="560"
                        height="200"
                        alt="For My Fans Only"
                        style="
                          display: block;
                          width: 100%;
                          max-width: 560px;
                          height: auto;
                          border: 0;
                          background-color: #ffffff;
                        "
                      />
                    </td>
                  </tr>
                </table>

                <!-- body -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                >
                  <tr>
                    <td class="pad" style="padding: 32px 44px 8px 44px">
                      <p
                        class="h1"
                        style="
                          margin: 0 0 14px 0;
                          font-family:
                            &quot;Segoe UI&quot;, Roboto, Helvetica, Arial,
                            sans-serif;
                          font-size: 24px;
                          line-height: 1.3;
                          font-weight: 700;
                          color: #1f0a16;
                          letter-spacing: -0.4px;
                        "
                      >
                        Hi <%= name %>,
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-family:
                            &quot;Segoe UI&quot;, Roboto, Helvetica, Arial,
                            sans-serif;
                          font-size: 16px;
                          line-height: 1.6;
                          color: #5c4453;
                        "
                      >
                        Here's the code to verify your email and finish setting
                        up your account.
                      </p>
                    </td>
                  </tr>

                  <!-- code -->
                  <tr>
                    <td class="pad" style="padding: 26px 44px 0 44px">
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <td
                            class="codebox"
                            align="center"
                            style="
                              background-color: #fdf2f6;
                              border: 1px solid #f6d3e1;
                              border-radius: 14px;
                              padding: 26px 16px 22px 16px;
                            "
                          >
                            <div
                              class="code"
                              style="
                                font-family:
                                  &quot;Segoe UI&quot;, Roboto, Helvetica,
                                  Arial, sans-serif;
                                font-size: 42px;
                                line-height: 1.1;
                                font-weight: 700;
                                color: #d81b60;
                                letter-spacing: 11px;
                                text-indent: 11px;
                              "
                            >
                              <%= otp %>
                            </div>
                            <div
                              class="muted"
                              style="
                                margin-top: 12px;
                                font-family:
                                  &quot;Segoe UI&quot;, Roboto, Helvetica,
                                  Arial, sans-serif;
                                font-size: 13px;
                                line-height: 1.5;
                                color: #8a6c7c;
                              "
                            >
                              Expires in <%= expiresInMinutes %> minutes
                            </div>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <!-- reassurance -->
                  <tr>
                    <td class="pad" style="padding: 24px 44px 0 44px">
                      <p
                        style="
                          margin: 0;
                          font-family:
                            &quot;Segoe UI&quot;, Roboto, Helvetica, Arial,
                            sans-serif;
                          font-size: 14px;
                          line-height: 1.65;
                          color: #5c4453;
                        "
                      >
                        Enter it on the verification screen while it's still
                        open. If you didn't try to sign up, you can ignore this
                        email &mdash; nothing will happen without the code.
                      </p>
                    </td>
                  </tr>

                  <tr>
                    <td class="pad" style="padding: 26px 44px 0 44px">
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <td
                            class="rule"
                            style="
                              border-top: 1px solid #f1e2e9;
                              font-size: 0;
                              line-height: 0;
                            "
                          >
                            &nbsp;
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <tr>
                    <td class="pad" style="padding: 18px 44px 34px 44px">
                      <p
                        class="muted"
                        style="
                          margin: 0;
                          font-family:
                            &quot;Segoe UI&quot;, Roboto, Helvetica, Arial,
                            sans-serif;
                          font-size: 13px;
                          line-height: 1.6;
                          color: #8a6c7c;
                        "
                      >
                        Never share this code. Our team will never ask you for
                        it.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- ============ FOOTER ============ -->
            <tr>
              <td
                class="foot"
                align="center"
                style="padding: 24px 24px 8px 24px; background-color: #f7eff3"
              >
                <p
                  style="
                    margin: 0 0 10px 0;
                    font-family:
                      &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif;
                    font-size: 14px;
                    line-height: 1.5;
                  "
                >
                  <a
                    href="https://www.formyfansonly.com"
                    style="
                      color: #d81b60;
                      text-decoration: none;
                      font-weight: 600;
                    "
                    >www.formyfansonly.com</a
                  >
                </p>
                <p
                  class="foot-text"
                  style="
                    margin: 0 0 6px 0;
                    font-family:
                      &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif;
                    font-size: 12px;
                    line-height: 1.6;
                    color: #93798a;
                  "
                >
                  You received this email because someone entered this address
                  when signing up for For My Fans Only.
                </p>
                <p
                  class="foot-text"
                  style="
                    margin: 0;
                    font-family:
                      &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif;
                    font-size: 12px;
                    line-height: 1.6;
                    color: #93798a;
                  "
                >
                  &copy; 2026 For My Fans Only. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
